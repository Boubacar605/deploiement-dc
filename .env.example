# Base de données PostgreSQL
POSTGRES_USER=xeuysil
POSTGRES_PASSWORD=changeme
POSTGRES_DB=xeuysil

# URL de connexion Prisma
DATABASE_URL=postgresql://xeuysil:changeme@postgres:5432/xeuysil?schema=public

# Supabase (authentification et stockage photos)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=changeme
SUPABASE_SERVICE_ROLE_KEY=changeme
SUPABASE_PICTURE_BUCKET=pictureProfile

# WhatsApp Business API
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=changeme
WHATSAPP_ACCESS_TOKEN=changeme
WHATSAPP_WEBHOOK_VERIFY_TOKEN=changeme
WHATSAPP_APP_SECRET=changeme

# Application
PORT=3000
API_PREFIX=api/v1
NODE_ENV=production
FRONTEND_URL=http://localhost

# Commissions
COMMISSION_PERCENT=10
MAX_COMMISSION_DEBT=50000

# Secret pour les tokens de démo locale (ne pas utiliser en production)
DEMO_SECRET=xeuysil-demo-secret-not-for-production

# Docker Hub
DOCKER_REGISTRY=xeuysil
IMAGE_TAG=latest
